# Client-only Vita distribution. Shared engine code is still needed by the client.
set(BUILD_CLIENT ON CACHE BOOL "" FORCE)
set(BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(BUILD_UNITTESTS OFF CACHE BOOL "" FORCE)
set(BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(BUILD_DOCUMENTATION OFF CACHE BOOL "" FORCE)
set(RUN_IN_PLACE OFF CACHE BOOL "" FORCE)
set(ENABLE_OPENGL OFF CACHE BOOL "" FORCE)
set(ENABLE_OPENGL3 OFF CACHE BOOL "" FORCE)
set(ENABLE_GLES2 ON CACHE BOOL "" FORCE)
set(USE_SDL2_STATIC ON CACHE BOOL "" FORCE)
set(ENABLE_GETTEXT OFF CACHE BOOL "" FORCE)
set(ENABLE_CURSES OFF CACHE BOOL "" FORCE)
set(ENABLE_POSTGRESQL OFF CACHE BOOL "" FORCE)
set(ENABLE_REDIS OFF CACHE BOOL "" FORCE)
set(ENABLE_LEVELDB OFF CACHE BOOL "" FORCE)
set(ENABLE_SPATIAL OFF CACHE BOOL "" FORCE)
set(ENABLE_PROMETHEUS OFF CACHE BOOL "" FORCE)
set(ENABLE_LUAJIT OFF CACHE BOOL "" FORCE)
set(ENABLE_OPENSSL OFF CACHE BOOL "" FORCE)
set(ENABLE_UPDATE_CHECKER OFF CACHE BOOL "" FORCE)
set(ENABLE_LTO OFF CACHE BOOL "" FORCE)
# Start with UDP media delivery; HTTPS requires a validated Vita trust store.
set(ENABLE_CURL OFF CACHE BOOL "" FORCE)
set(CMAKE_DL_LIBS "") # Vita has no POSIX dynamic loader.
add_compile_options(-ffunction-sections -fdata-sections)
add_link_options(-Wl,--gc-sections)
